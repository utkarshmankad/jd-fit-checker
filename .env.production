# Reference only — real values live in the Vercel dashboard (Production env).
# Never put real secrets in this file; it is committed to git as documentation.

# ─── ENVIRONMENT ─────────────────────────────────
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_APP_NAME=JobSnob
NEXT_PUBLIC_SHOW_DEV_BANNER=false

# ─── SUPABASE (PROD PROJECT) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=SET_IN_VERCEL
NEXT_PUBLIC_SUPABASE_ANON_KEY=SET_IN_VERCEL
SUPABASE_SERVICE_ROLE_KEY=SET_IN_VERCEL

# ─── SCREENING API ────────────────────────────────
NEXT_PUBLIC_SCREENING_API_URL=SET_IN_VERCEL

# ─── APP URL ─────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://jobsnob.fyi

# ─── ENCRYPTION ──────────────────────────────────
ENCRYPTION_SECRET=SET_IN_VERCEL

# ─── RAZORPAY (LIVE MODE) ────────────────────────
RAZORPAY_KEY_ID=SET_IN_VERCEL
RAZORPAY_KEY_SECRET=SET_IN_VERCEL
NEXT_PUBLIC_RAZORPAY_KEY_ID=SET_IN_VERCEL
RAZORPAY_WEBHOOK_SECRET=SET_IN_VERCEL

# ─── FEATURE FLAGS ───────────────────────────────
NEXT_PUBLIC_FEATURE_SCREEN_LIMIT=SET_IN_VERCEL
LAUNCH_MODE=true
BETA_INVITE_CODE=SET_IN_VERCEL
FREE_WEEKLY_LIMIT=3
BETA_TOTAL_LIMIT=25
NEXT_PUBLIC_PRICING_ENABLED=SET_IN_VERCEL

# ─── OPENAI (server-side beta/launch key) ────────
APP_OPENAI_API_KEY=SET_IN_VERCEL

# ─── FEEDBACK DIGEST EMAIL ────────────────────────
RESEND_API_KEY=SET_IN_VERCEL
FEEDBACK_EMAIL_TO=SET_IN_VERCEL
FEEDBACK_EMAIL_FROM=SET_IN_VERCEL
CRON_SECRET=SET_IN_VERCEL
