ENCRYPTION_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

NEXT_PUBLIC_FEATURE_SCREEN_LIMIT=false
LAUNCH_MODE=true
BETA_INVITE_CODE=
FREE_WEEKLY_LIMIT=3
BETA_TOTAL_LIMIT=25
NEXT_PUBLIC_PRICING_ENABLED=false

APP_OPENAI_API_KEY=
RESEND_API_KEY=
