NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SCREENING_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32-byte hex key — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=
# Set to 'true' to enforce the free-tier 5-screen monthly limit; omit or set 'false' to disable
NEXT_PUBLIC_FEATURE_SCREEN_LIMIT=false

LAUNCH_MODE=true
# When true: free users get 25 screens total (not per week)
# When false: free users get 3 screens per week
# Switch to false after first 30 days or when going fully public

BETA_INVITE_CODE=EARLYEM2026
# Anyone who signs up with this code gets beta limits
# regardless of LAUNCH_MODE setting

FREE_WEEKLY_LIMIT=3
# The post-launch weekly limit for organic free users

BETA_TOTAL_LIMIT=25
# Total screens for beta/launch-mode users

APP_OPENAI_API_KEY=
# Your OpenAI API key. Screens 1-25 for beta/launch-mode users run on this
# key server-side — 26th+ screen requires the user's own key. Leave blank
# to always require the user's own key from screen 1.

NEXT_PUBLIC_PRICING_ENABLED=false
# Master switch for the entire pricing/limits feature. false = unlimited
# screens for everyone, no pricing/upgrade UI renders anywhere.

RESEND_API_KEY=
# From resend.com/api-keys. Sends the feedback digest email.
FEEDBACK_EMAIL_TO=
# Where feedback digests land — your own inbox.
FEEDBACK_EMAIL_FROM=
# Optional, e.g. "JD Fit Checker <feedback@yourdomain.com>" once you've
# verified a sending domain in Resend. Leave blank to use Resend's shared
# onboarding@resend.dev sender (works without domain verification, but
# only delivers to the email address on your Resend account).
CRON_SECRET=
# Random secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vercel Cron sends this back as "Authorization: Bearer $CRON_SECRET"
# automatically once set; /api/feedback/digest checks it so the digest
# can't be triggered by anyone who finds the URL.

ADMIN_SECRET=
# Random secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Gates /admin. Entered once via a password form (POST), never appears in
# a URL. Leave unset to disable /admin entirely.

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# From your PostHog project settings. Leave NEXT_PUBLIC_POSTHOG_KEY unset to
# disable analytics entirely (initPostHog() no-ops without it). Capture is
# also opted out automatically in NODE_ENV=development regardless of key.
